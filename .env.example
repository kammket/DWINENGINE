# Environment Variables — Limitum Platform
# Copy this file to .env.local and fill in values

# ──────────────────────────────────────────
# App
# ──────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Limitum

# ──────────────────────────────────────────
# Database (PostgreSQL via Prisma)
# ──────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/limitum?schema=public"

# ──────────────────────────────────────────
# Authentication (NextAuth.js)
# ──────────────────────────────────────────
NEXTAUTH_SECRET=your-super-secret-nextauth-key-min-32-chars
NEXTAUTH_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple OAuth
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# ──────────────────────────────────────────
# JWT (custom tokens)
# ──────────────────────────────────────────
JWT_SECRET=your-jwt-secret-key-min-32-chars

# ──────────────────────────────────────────
# OpenAI
# ──────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ──────────────────────────────────────────
# Stripe
# ──────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PREMIUM_MONTHLY=price_...
STRIPE_PRICE_PREMIUM_ANNUAL=price_...
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_...

# ──────────────────────────────────────────
# Email (Nodemailer / SMTP)
# ──────────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=your-resend-api-key
SMTP_FROM="Limitum <hello@limitum.ai>"

# ──────────────────────────────────────────
# Bitcoin (direct on-chain payments — no fees, no API keys)
# Set to your Bitcoin wallet's receiving address.
# Leave blank to disable the Bitcoin payment option.
# ──────────────────────────────────────────
BITCOIN_ADDRESS=

# ──────────────────────────────────────────
# Redis (rate limiting, optional)
# ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379
