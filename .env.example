# Environment Variables — Constavita Platform
# Copy this file to .env.local for local dev
# On Vercel: add each variable in the Vercel dashboard → Settings → Environment Variables

# ──────────────────────────────────────────
# App
# ──────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
NEXT_PUBLIC_APP_NAME=Constavita

# ──────────────────────────────────────────
# Database (Neon PostgreSQL)
# Get both URLs from: neon.tech → your project → Connection Details
#
# DATABASE_URL  → use the "Pooled connection" string (ends in -pooler.neon.tech)
# DIRECT_URL    → use the "Direct connection" string (does NOT have -pooler)
# ──────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.us-east-2.aws.neon.tech/constavita?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/constavita?sslmode=require"

# ──────────────────────────────────────────
# JWT (custom tokens)
# Generate a random 32+ character string — use: openssl rand -base64 32
# ──────────────────────────────────────────
JWT_SECRET=your-jwt-secret-min-32-chars

# ──────────────────────────────────────────
# OpenAI
# ──────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ──────────────────────────────────────────
# Stripe
# Get these from: dashboard.stripe.com → Developers → API keys
# ──────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PREMIUM_MONTHLY=price_...
STRIPE_PRICE_PREMIUM_ANNUAL=price_...
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_...

# ──────────────────────────────────────────
# Email (Resend — free up to 3,000 emails/mo)
# Sign up at resend.com, create an API key
# ──────────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_your-resend-api-key
SMTP_FROM="Constavita <hello@yourdomain.com>"

# ──────────────────────────────────────────
# Bitcoin (optional — leave blank to disable)
# ──────────────────────────────────────────
BITCOIN_ADDRESS=

# ──────────────────────────────────────────
# Redis (optional — for rate limiting)
# Leave blank to use in-memory rate limiting
# ──────────────────────────────────────────
REDIS_URL=
